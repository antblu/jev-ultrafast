TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
# Optional comma-separated choices shown by the local demo. All use the base URL and API key above.
TEXT_MODEL_OPTIONS=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Per-attempt timeout for TypeSafe and OpenAI-compatible model requests.
MODEL_TIMEOUT_SECONDS=60
# Completion budgets include any provider-exposed reasoning tokens.
LLM_DECISION_MAX_TOKENS=1024
# auto uses forced function calling for GLM/Z.ai models and JSON mode otherwise. Values: auto, tool, json.
LLM_DECISION_FORMAT=auto
TEXT_VALUE_MAX_TOKENS=1024
# Server-side destination for opt-in UI logs of indexed pages and model questions.
QUESTION_LOG_DIR=artifacts/questions
